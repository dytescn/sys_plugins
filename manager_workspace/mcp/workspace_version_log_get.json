{
  "name": "workspace_version_log_get",
  "title": "版本日志详情",
  "description": "按 id 或 uuid 读取版本日志。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "description": "自增主键"
      },
      "uuid": {
        "type": "string",
        "description": "业务 uuid"
      },
      "include_deleted": {
        "type": "boolean",
        "description": "读取时是否包含已删除",
        "default": false
      }
    },
    "anyOf": [
      {
        "required": [
          "id"
        ]
      },
      {
        "required": [
          "uuid"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/workspace_lib",
    "ffiSymbol": "version_log_get"
  }
}
