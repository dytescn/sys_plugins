{
  "name": "workspace_version_update",
  "title": "更新项目版本",
  "description": "按 id 或 uuid 更新项目版本白名单字段。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "description": "自增主键"
      },
      "uuid": {
        "type": "string",
        "description": "业务 uuid"
      },
      "project_uid": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "start_time": {
        "type": "string"
      },
      "publish_time": {
        "type": "string"
      },
      "plan_publish_time": {
        "type": "string"
      },
      "schedule": {
        "type": "integer"
      },
      "status": {
        "type": "string"
      },
      "features_uid": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "required": [
          "id"
        ]
      },
      {
        "required": [
          "uuid"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/workspace_lib",
    "ffiSymbol": "version_update"
  }
}
