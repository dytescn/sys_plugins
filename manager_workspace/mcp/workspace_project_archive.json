{
  "name": "workspace_project_archive",
  "title": "归档项目",
  "description": "归档或取消归档项目。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "uuid": {
        "type": "string"
      },
      "archived": {
        "type": "boolean",
        "description": "true 归档，false 取消归档",
        "default": true
      }
    },
    "anyOf": [
      {
        "required": [
          "id"
        ]
      },
      {
        "required": [
          "uuid"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/workspace_lib",
    "ffiSymbol": "project_archive"
  }
}
