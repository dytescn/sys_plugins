{
  "name": "workspace_design_version_update",
  "title": "更新设计版本",
  "description": "按 id 或 uuid 更新设计版本白名单字段。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "description": "自增主键"
      },
      "uuid": {
        "type": "string",
        "description": "业务 uuid"
      },
      "cover": {
        "type": "string"
      },
      "design_uid": {
        "type": "string"
      },
      "child_uid": {
        "type": "string"
      },
      "soft_ver": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "logs": {
        "type": "string"
      },
      "fuid": {
        "type": "string"
      },
      "create_by": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "required": [
          "id"
        ]
      },
      {
        "required": [
          "uuid"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/workspace_lib",
    "ffiSymbol": "design_version_update"
  }
}
