{
  "name": "workspace_log_create",
  "title": "新建项目日志",
  "description": "新建项目日志；project_uid 必填。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "description": "可选，缺省自动生成"
      },
      "project_uid": {
        "type": "string"
      },
      "task_uid": {
        "type": "string"
      },
      "staff_uid": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "remark": {
        "type": "string"
      },
      "log_type": {
        "type": "string"
      },
      "action_type": {
        "type": "string"
      },
      "to_staff_uid": {
        "type": "string"
      },
      "is_comment": {
        "type": "integer"
      }
    },
    "required": [
      "project_uid"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/workspace_lib",
    "ffiSymbol": "log_create"
  },
  "category": "workspace",
  "tags": [
    "workspace",
    "project",
    "readonly",
    "write"
  ]
}
