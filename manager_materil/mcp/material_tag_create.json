{
  "name": "material_tag_create",
  "title": "新建标签",
  "description": "新建标签；name 必填。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "description": "可选，缺省自动生成"
      },
      "name": {
        "type": "string",
        "description": "标签名称"
      },
      "kind": {
        "type": "string",
        "description": "标签类型",
        "enum": [
          "general",
          "color",
          "style",
          "scene",
          "element",
          "usage",
          "format"
        ],
        "default": "general"
      },
      "source": {
        "type": "string",
        "description": "来源",
        "enum": [
          "manual",
          "ai"
        ],
        "default": "manual"
      },
      "color": {
        "type": "string",
        "description": "颜色"
      },
      "sort": {
        "type": "integer",
        "description": "排序"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/material_lib",
    "ffiSymbol": "tag_create",
    "library": "material_lib",
    "library_uuid": "3a3bea1e-e3cb-4765-b0e6-b8d2333bb375"
  },
  "category": "material",
  "tags": [
    "material",
    "readonly",
    "write",
    "file"
  ]
}
