{
  "name": "material_file_search",
  "title": "语义搜索素材",
  "description": "按语义搜索素材内容，返回带 score 的素材记录；依赖 chatllm 向量服务。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "搜索语句"
      },
      "top_k": {
        "type": "integer",
        "description": "返回条数，默认 5，范围 1-50",
        "minimum": 1,
        "maximum": 50,
        "default": 5
      },
      "min_score": {
        "type": "number",
        "description": "最低相似度，默认 0.2",
        "default": 0.2
      },
      "type_uid": {
        "type": "string",
        "description": "按类型过滤"
      },
      "tag_uuid": {
        "type": "string",
        "description": "按标签过滤"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/material_lib",
    "ffiSymbol": "file_search"
  }
}
