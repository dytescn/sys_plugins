{
  "name": "material_type_create",
  "title": "新建素材类型",
  "description": "新建素材类型；type_name 必填。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "description": "可选，缺省自动生成"
      },
      "type_name": {
        "type": "string",
        "description": "类型名称"
      },
      "icon": {
        "type": "string",
        "description": "类型图标"
      }
    },
    "required": [
      "type_name"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/material_lib",
    "ffiSymbol": "type_create"
  },
  "category": "material",
  "tags": [
    "material",
    "readonly",
    "write",
    "file"
  ]
}
