{
  "name": "material_file_create",
  "title": "新建素材文件",
  "description": "新建素材文件；name 必填。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "description": "可选，缺省自动生成"
      },
      "project_uid": {
        "type": "string",
        "description": "所属项目"
      },
      "organ_uid": {
        "type": "string",
        "description": "组织标识"
      },
      "flow_uid": {
        "type": "string",
        "description": "流程标识"
      },
      "type_uid": {
        "type": "string",
        "description": "素材类型"
      },
      "name": {
        "type": "string",
        "description": "素材名称"
      },
      "description": {
        "type": "string",
        "description": "描述"
      },
      "cover": {
        "type": "string",
        "description": "封面"
      },
      "create_by": {
        "type": "string",
        "description": "创建人"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/material_lib",
    "ffiSymbol": "file_create"
  },
  "category": "material",
  "tags": [
    "material",
    "readonly",
    "write",
    "file"
  ]
}
