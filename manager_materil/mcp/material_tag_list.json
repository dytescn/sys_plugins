{
  "name": "material_tag_list",
  "title": "查询标签列表",
  "description": "分页查询标签字典，支持类型与关键词过滤。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "page": {
        "type": "integer",
        "description": "页码，默认 1",
        "minimum": 1,
        "default": 1
      },
      "page_size": {
        "type": "integer",
        "description": "每页数量，默认 20，上限 100",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "kind": {
        "type": "string",
        "description": "标签类型",
        "enum": [
          "general",
          "color",
          "style",
          "scene",
          "element",
          "usage",
          "format"
        ]
      },
      "keyword": {
        "type": "string",
        "description": "名称模糊匹配"
      },
      "include_deleted": {
        "type": "boolean",
        "description": "包含已删除",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/material_lib",
    "ffiSymbol": "tag_list"
  },
  "category": "material",
  "tags": [
    "material",
    "readonly",
    "write",
    "file"
  ]
}
