{
  "name": "sysinfo_file_info",
  "title": "文件信息",
  "description": "读取文件 / 目录大小、类型、修改与创建时间；不跟随符号链接。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "文件或目录路径"
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/sysinfo",
    "ffiSymbol": "file_info"
  },
  "category": "system",
  "tags": [
    "system",
    "readonly",
    "info"
  ]
}
