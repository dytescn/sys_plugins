{
  "name": "info_router_update",
  "title": "修改路由",
  "description": "按 id 修改路由；只更新传入的字段，至少提供一个字段。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "description": "固定整数 ID，省略时自增"
      },
      "title": {
        "type": "string",
        "description": "菜单标题"
      },
      "icon": {
        "type": "string",
        "description": "图标名"
      },
      "hide": {
        "type": "integer",
        "description": "1 表示不在侧边栏显示"
      },
      "path": {
        "type": "string",
        "description": "页面路由路径"
      },
      "child": {
        "type": "string",
        "description": "历史 JSON 字段，运行时以 parent_id 为准"
      },
      "url": {
        "type": "string",
        "description": "页面脚本路径，分组节点可为空"
      },
      "show": {
        "type": "integer",
        "description": "入口是否展示"
      },
      "parent_id": {
        "type": "integer",
        "description": "父路由 ID；根为 0"
      },
      "level": {
        "type": "integer",
        "description": "层级，1 或 2"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/info_lib",
    "ffiSymbol": "router_update"
  }
}
