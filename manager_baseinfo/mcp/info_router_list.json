{
  "name": "info_router_list",
  "title": "查询路由列表",
  "description": "分页查询路由，支持父路由、隐藏状态、路径与关键词过滤。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "parent_id": {
        "type": "integer",
        "description": "按父路由过滤"
      },
      "hide": {
        "type": "integer",
        "description": "0 / 1"
      },
      "path": {
        "type": "string",
        "description": "精确匹配路径"
      },
      "keyword": {
        "type": "string",
        "description": "title / path 模糊匹配"
      },
      "page": {
        "type": "integer",
        "description": "页码，默认 1",
        "minimum": 1,
        "default": 1
      },
      "page_size": {
        "type": "integer",
        "description": "每页数量，默认 100，上限 500",
        "minimum": 1,
        "maximum": 500,
        "default": 100
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/info_lib",
    "ffiSymbol": "router_list"
  }
}
