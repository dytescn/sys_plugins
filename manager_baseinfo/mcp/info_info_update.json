{
  "name": "info_info_update",
  "title": "修改设置项",
  "description": "按 id 或 key 修改设置项；key 不可修改，note 单独 upsert。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "description": "设置项 ID"
      },
      "key": {
        "type": "string",
        "description": "设置键，唯一"
      },
      "title": {
        "type": "string",
        "description": "显示标题"
      },
      "value": {
        "type": "string",
        "description": "值，按 value_type 解释"
      },
      "value_type": {
        "type": "string",
        "description": "值类型",
        "enum": [
          "string",
          "number",
          "boolean",
          "json",
          "array",
          "date",
          "enum",
          "path",
          "url",
          "color",
          "secret"
        ]
      },
      "category": {
        "type": "string",
        "description": "分类键，对应 setting_note.key"
      },
      "description": {
        "type": "string",
        "description": "说明"
      },
      "note": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "分类键；省略时使用 category"
          },
          "language": {
            "type": "string",
            "description": "语言，默认 default"
          },
          "title": {
            "type": "string",
            "description": "分类标题"
          },
          "description": {
            "type": "string",
            "description": "分类说明"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "anyOf": [
      {
        "required": [
          "id"
        ]
      },
      {
        "required": [
          "key"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/info_lib",
    "ffiSymbol": "info_update"
  },
  "category": "info",
  "tags": [
    "settings",
    "router",
    "readonly",
    "write"
  ]
}
