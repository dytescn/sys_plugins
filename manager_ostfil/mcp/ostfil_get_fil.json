{
  "name": "ostfil_get_fil",
  "title": "读取已存储对象",
  "description": "按 uuid 读取 storage/<uuid>/ 下的对象信息；必要时解压 original.z。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "description": "存储对象 uuid"
      }
    },
    "required": [
      "uuid"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/libostfil",
    "ffiSymbol": "get_fil"
  }
}
