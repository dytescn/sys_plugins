{
  "name": "ostfil_storage",
  "title": "存储本地文件",
  "description": "把已有本地文件复制到 storage/<uuid>/，返回 uuid、大小、扩展名、结束时间与 md5。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string",
        "description": "本地文件绝对路径"
      }
    },
    "required": [
      "file_path"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/libostfil",
    "ffiSymbol": "storage",
    "library": "ostfil",
    "library_uuid": "0bddf9d9-9a72-43e7-ac64-6e9e39b773be"
  },
  "category": "file",
  "tags": [
    "file",
    "readonly",
    "write",
    "storage"
  ]
}
