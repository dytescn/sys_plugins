{
  "name": "plugin_get_versions",
  "title": "版本列表",
  "description": "读取指定插件的版本列表。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "plugin_uuid": {
        "type": "string",
        "description": "插件 uuid"
      }
    },
    "required": [
      "plugin_uuid"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "get_versions"
  },
  "category": "plugin",
  "tags": [
    "plugin",
    "readonly",
    "write",
    "settings"
  ]
}
