{
  "name": "plugin_get_plugins",
  "title": "插件列表",
  "description": "分页查询设计插件，支持分类、关键词、状态与目标软件过滤。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "description": "分类 uuid 或 category_id"
      },
      "keyword": {
        "type": "string",
        "description": "名称 / 描述模糊匹配"
      },
      "status": {
        "type": "string",
        "description": "发布状态"
      },
      "target": {
        "type": "string",
        "description": "目标软件",
        "enum": [
          "common",
          "coreldraw",
          "photoshop",
          "autocad",
          "vectorcraft"
        ]
      },
      "page": {
        "type": "integer",
        "description": "页码，默认 1",
        "minimum": 1,
        "default": 1
      },
      "page_size": {
        "type": "integer",
        "description": "每页数量，默认 20",
        "minimum": 1,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "get_plugins"
  }
}
