{
  "name": "plugin_get_plugin",
  "title": "插件详情",
  "description": "按 uuid 或 name 读取单个插件。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "description": "插件 uuid"
      },
      "name": {
        "type": "string",
        "description": "插件名"
      }
    },
    "anyOf": [
      {
        "required": [
          "uuid"
        ]
      },
      {
        "required": [
          "name"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "get_plugin",
    "library": "plugin_lib",
    "library_uuid": "8b1c9907-692d-473e-8676-459aec1ec6ba"
  },
  "category": "plugin",
  "tags": [
    "plugin",
    "readonly",
    "write",
    "settings"
  ]
}
