{
  "name": "plugin_patch_function",
  "title": "回写能力状态",
  "description": "回写能力的 AI 召回与向量化状态。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string"
      },
      "use_ai": {
        "type": [
          "boolean",
          "integer"
        ]
      },
      "embed_status": {
        "type": "integer"
      },
      "embed_model": {
        "type": "string"
      },
      "embed_text_hash": {
        "type": "string"
      },
      "embedded_at": {
        "type": "integer"
      }
    },
    "required": [
      "uuid"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "patch_function"
  }
}
