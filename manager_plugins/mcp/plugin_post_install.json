{
  "name": "plugin_post_install",
  "title": "安装插件",
  "description": "通过 dytes 安装设计插件；plugin_uuid 或 name 至少一个。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "plugin_uuid": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "file_path": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "required": [
          "plugin_uuid"
        ]
      },
      {
        "required": [
          "name"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "post_install"
  },
  "category": "plugin",
  "tags": [
    "plugin",
    "readonly",
    "write",
    "settings"
  ]
}
