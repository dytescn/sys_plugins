{
  "name": "plugin_get_skills",
  "title": "技能列表",
  "description": "读取技能列表，支持分类、id、插件、启用状态与正文过滤。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "技能分类"
      },
      "ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "技能 id"
      },
      "plugin_uuid": {
        "type": "string",
        "description": "插件 uuid"
      },
      "enabled": {
        "type": [
          "boolean",
          "integer"
        ],
        "description": "是否启用"
      },
      "with_content": {
        "type": "boolean",
        "description": "是否返回正文"
      },
      "page": {
        "type": "integer",
        "description": "页码，默认 1",
        "minimum": 1,
        "default": 1
      },
      "page_size": {
        "type": "integer",
        "description": "每页数量，默认 20",
        "minimum": 1,
        "default": 20
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "get_skills"
  },
  "category": "plugin",
  "tags": [
    "plugin",
    "readonly",
    "write",
    "settings"
  ]
}
