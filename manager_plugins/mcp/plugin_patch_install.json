{
  "name": "plugin_patch_install",
  "title": "局部更新安装状态",
  "description": "局部更新安装记录。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "plugin_uuid": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "install_path": {
        "type": "string"
      },
      "enabled": {
        "type": "integer"
      }
    },
    "required": [
      "plugin_uuid"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "patch_install"
  }
}
