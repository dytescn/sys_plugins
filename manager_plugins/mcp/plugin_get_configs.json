{
  "name": "plugin_get_configs",
  "title": "配置定义",
  "description": "读取插件配置定义与当前值。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "plugin_uuid": {
        "type": "string",
        "description": "插件 uuid"
      },
      "version": {
        "type": "string",
        "description": "版本号"
      },
      "version_id": {
        "type": "integer",
        "description": "版本 ID"
      }
    },
    "required": [
      "plugin_uuid"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "业务状态码，200 表示成功"
      },
      "data": {
        "description": "业务数据"
      },
      "msg": {
        "type": "string",
        "description": "success 或错误描述"
      }
    },
    "required": [
      "code",
      "msg"
    ],
    "additionalProperties": false
  },
  "transport": {
    "endpoint": "/plugin_lib",
    "ffiSymbol": "get_configs"
  }
}
